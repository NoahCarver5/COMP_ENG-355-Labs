# Quartus Prime
# Version 26.1.1 Build 130 08/06/2026 SC Pro Edition
# Date created = 20:21:34  September 10, 2026
#
# -------------------------------------------------------------------------- #
set_global_assignment -name TOP_LEVEL_ENTITY drum_pad_system
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 26.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "20:21:34  SEPTEMBER 10, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "26.1.1 Pro Edition"
set_global_assignment -name SDC_FILE drum_pad.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name DEVICE A5ED013BB32AE4SCS
set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"


#============================================================
# System Clock & Reset (CLOCK0_50, CPU_RESET_n)
#============================================================
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to clk
set_instance_assignment -name IO_STANDARD "1.2-V" -to rst_n

#============================================================
# KEYS
#============================================================
set_instance_assignment -name IO_STANDARD "1.2-V" -to key_n[0]
set_instance_assignment -name IO_STANDARD "1.2-V" -to key_n[1]
set_instance_assignment -name IO_STANDARD "1.2-V" -to key_n[2]
set_instance_assignment -name IO_STANDARD "1.2-V" -to key_n[3]

#============================================================
# SW
#============================================================
set_instance_assignment -name IO_STANDARD "1.2-V" -to sw[0]
set_instance_assignment -name IO_STANDARD "1.2-V" -to sw[1]
set_instance_assignment -name IO_STANDARD "1.2-V" -to sw[2]

#============================================================
# LED (LEDR[0])
#============================================================
set_instance_assignment -name IO_STANDARD "1.2-V" -to led_n

#============================================================
# Audio Codec
#============================================================
set_instance_assignment -name IO_STANDARD "1.2-V" -to AUD_XCK
set_instance_assignment -name IO_STANDARD "1.2-V" -to AUD_BCLK
set_instance_assignment -name IO_STANDARD "1.2-V" -to AUD_DACLRCK
set_instance_assignment -name IO_STANDARD "1.2-V" -to AUD_DACDAT

#============================================================
# I2C (FPGA_I2C_SCLK, FPGA_I2C_SDAT)
#============================================================
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FPGA_I2C_SCL
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FPGA_I2C_SDA
